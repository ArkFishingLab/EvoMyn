# DEVICE_GATEWAY_CERT=
# DEVICE_GATEWAY_KEY=
# DEVICE_GATEWAY_ALLOWED_HOSTS=
# DEVICE_GATEWAY_PORT=18773
# DEVICE_UPDATE_DIR=
# PLANNER_DEVICE_ID=
# PLANNER_DEVICE_TOKEN=
