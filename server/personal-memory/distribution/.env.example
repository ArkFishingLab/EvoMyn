# Optional Xiaozhi endpoint. Configure privately at /setup/; never commit .env.
MCP_ENDPOINT=
PLANNER_OWNER=device
DASHBOARD_PORT=18768
ARCHIVE_PORT=18770
ADMIN_PORT=18772
# Optional legacy PC planner ports; device ownership does not open them.
PLANNER_PORT=18769
PLANNER_WS_PORT=18771
